{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build with SFML",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\AlienGame.exe",
                "-I${fileDirname}\\include",
                "-L${fileDirname}\\lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-mconsole"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}